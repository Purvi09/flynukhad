{
  "name": "nukkad",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "models": "/Applications/Blender.app/Contents/MacOS/Blender --background --python blender/make_models.py",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.2.0",
    "earcut": "^3.2.3",
    "firebase": "^12.18.0",
    "hono": "^4.13.7",
    "three": "^0.185.1",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/three": "^0.185.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2"
  }
}
