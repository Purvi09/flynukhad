# Server-side only. Never prefix these with VITE_ or they would ship to the browser.
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
# (NEXT_PUBLIC_GOOGLE_MAPS_API_KEY from the original 2D project is also accepted as a fallback.)

# Firebase web config, exposed to the browser. Vite only exposes VITE_-prefixed
# variables, which is why these are not NEXT_PUBLIC_ as in the original project.
# To convert: sed 's/^NEXT_PUBLIC_/VITE_/' on the FIREBASE lines of the old .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
