{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "@shared/*": ["../shared/*"] },
    "baseUrl": "."
  },
  "include": ["./**/*.ts", "../shared/**/*.ts"]
}
